<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:background="@color/surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackTrackpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8592; Back"
            android:textSize="14sp"
            android:textColor="@color/primary"
            style="@style/Widget.Material3.Button.TextButton" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trackpad"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Spacer to visually balance the back button -->
        <View
            android:layout_width="80dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Touch surface — uses MaterialCardView for rounded corners and ripple -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/touchSurface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Touch to move cursor"
            android:textColor="@color/border"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/border" />

    <!-- Left / Right Click buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeftClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="LEFT CLICK"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_left"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRightClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="RIGHT CLICK"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_right"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
